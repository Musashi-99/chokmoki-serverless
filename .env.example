# Copy to .env and fill from your platform secret store. Never commit real secrets.

ENVIRONMENT=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/chokmoki
MONGODB_DB_NAME=chokmoki

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — use scripts/generate_admin_password_hash.py to generate ADMIN_PASSWORD_HASH.
# Prefer hash-only (leave ADMIN_PASSWORD blank) in every environment, including local dev.
# Only set plaintext ADMIN_PASSWORD if ADMIN_PASSWORD_HASH is empty — the two must not both be set.
JWT_SECRET=replace-with-openssl-rand-hex-32-or-longer
JWT_SECRET_PREVIOUS=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Cron / internal
CRON_SECRET=replace-with-local-cron-secret-16ch

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=

# Payment reconciliation (webhook-independent safety net, runs in the worker)
PAYMENT_RECONCILE_INTERVAL_SECONDS=1800
PAYMENT_RECONCILE_WINDOW_HOURS=2
PAYMENT_RECONCILE_FALLBACK_BATCH_SIZE=3
PAYMENT_RECONCILE_FALLBACK_INTERVAL_SECONDS=60

# Shiprocket
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_DEFAULT_WEIGHT_KG=0.3
SHIPROCKET_DEFAULT_LENGTH_CM=15
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=5
SHIPROCKET_DEFAULT_COURIER_SELECTION=cheapest

# GST — invoice tax display only; storefront prices are already GST-inclusive.
# Total rate (CGST + SGST) is sent per order item to Shiprocket so its
# generated invoice shows the tax split; CGST/SGST vs IGST is decided by
# Shiprocket from pickup state vs place of supply. 1.5 + 1.5 = 3% is the
# jewellery rate. HSN 7113 = precious-metal jewellery (sterling silver);
# use 7117 instead if selling imitation/fashion jewellery.
GST_ENABLED=true
GST_CGST_PERCENT=1.5
GST_SGST_PERCENT=1.5
GST_HSN_CODE=7113
# AU/NZ GST shown on their Tax Invoices — a single flat rate, no split.
# Placeholders at 0 until the business is actually GST-registered in each
# country; the real rates are AU 10% and NZ 15%.
GST_AU_PERCENT=0
GST_NZ_PERCENT=0

# Metrics
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-local-metrics-token

# R2 / Cloudflare — set only in deployment secret store
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chokmoki
R2_KEY_PREFIX=
R2_PUBLIC_BASE_URL=

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_FAIL_CLOSED=true
RATE_LIMIT_FAIL_CLOSED=false
TRUSTED_PROXY_ENABLED=false
TRUST_X_FORWARDED_FOR=false
# Force client-IP resolution from a specific header, checked before the
# TRUST_X_FORWARDED_FOR validator gate (so it is usable in production behind a
# proxy). Set to x-real-ip when a single trusted proxy (nginx $remote_addr) is in
# front — NOT spoofable. Use x-forwarded-for only if you understand it is
# client-spoofable at the leftmost hop. Leave empty to use the default trust chain.
RATE_LIMIT_IP_HEADER=
# Temporary diagnostic: dump all headers + resolved IP for /api/admin* and /api/orders.
LOG_CLIENT_IP_HEADERS=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=1800
LOGIN_FAILURE_WINDOW_SECONDS=900

# Inventory
INVENTORY_ENABLED=true
INVENTORY_RESERVATION_TTL_SECONDS=3600

# Fraud detection
FRAUD_ENABLED=true
FRAUD_FAIL_CLOSED=true
FRAUD_RULES_FILE=config/fraud_rules.yaml
FRAUD_VELOCITY_WINDOW_SECONDS=3600
FRAUD_DUPLICATE_WINDOW_SECONDS=900

# Multi-region pricing / GeoIP
# In docker compose this resolves to the `geoip` service on the shared
# network (see docker-compose.yml) — http://geoip:8080. Leave unset to make
# GeoIP fail open to the "default" pricing bucket instead of erroring.
GEOIP_SERVICE_URL=http://geoip:8080
GEOIP_LOOKUP_TIMEOUT_SECONDS=3.0
GEOIP_CACHE_TTL_SECONDS=14400
SUPPORTED_MARKET_COUNTRIES=IN,AU,NZ
# Markets that can pay online (Razorpay is INR-only). COD needs no gateway
# so it's available everywhere; only "pay online now" is India-only until
# a gateway that handles AUD/NZD is wired up.
PREPAID_ENABLED_COUNTRIES=IN

# Idempotency
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_REQUIRED_IN_PRODUCTION=true

# Invoice PDFs (admin panel) — seller/"Sold By" block printed on generated
# tax invoices / receipts / bills of supply. Should match your Shiprocket
# billing settings so both invoices agree.
INVOICE_BRAND_NAME=Chokmoki
INVOICE_BRAND_TAGLINE=Let the sparkle begin
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS1=
INVOICE_SELLER_ADDRESS2=
INVOICE_SELLER_CITY=
INVOICE_SELLER_PINCODE=
INVOICE_SELLER_STATE=West Bengal
INVOICE_SELLER_STATE_CODE=19
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=
INVOICE_NUMBER_PREFIX=INV

# MSG91 (customer phone+OTP login, lifecycle SMS). Per-event template IDs
# are admin-editable (admin panel > SMS Templates), not env vars.
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_EXPIRY_SECONDS=300
MSG91_OTP_LENGTH=4

# Brevo SMTP — email OTP login/signup (alternate to MSG91 while unverified)
# plus order-confirmation/status-update emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=https://www.chokmoki.com
EMAIL_OTP_EXPIRY_SECONDS=300
EMAIL_OTP_LENGTH=6

CUSTOMER_JWT_ACCESS_TTL_MINUTES=60
CUSTOMER_JWT_REFRESH_TTL_DAYS=90
